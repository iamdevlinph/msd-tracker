{
  "name": "msd-tracker",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "rm -rf dist && vite build && tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check",
    "fix": "biome check --fix",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@cloudflare/vite-plugin": "1.26.0",
    "@hookform/resolvers": "5.4.0",
    "@iconify-react/game-icons": "1.0.3",
    "@iconify/react": "6.0.2",
    "@icons-pack/react-simple-icons": "13.13.0",
    "@react-native-async-storage/async-storage": "3.0.2",
    "@react-oauth/google": "0.13.5",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/query-async-storage-persister": "5.100.9",
    "@tanstack/react-devtools": "0.10.3",
    "@tanstack/react-query": "5.100.1",
    "@tanstack/react-query-devtools": "5.100.9",
    "@tanstack/react-query-persist-client": "5.100.9",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-start": "1.167.65",
    "@tanstack/router-plugin": "1.167.35",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "common-utils-pkg": "4.3.2",
    "cookie": "1.1.1",
    "framer-motion": "12.38.0",
    "fuse.js": "7.3.0",
    "lucide-react": "0.577.0",
    "nanoid": "5.1.11",
    "next-themes": "0.4.6",
    "radix-ui": "1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.77.0",
    "react-hot-toast": "2.6.0",
    "react-intersection-observer": "10.0.3",
    "tailwind-merge": "3.0.2",
    "tailwindcss": "4.1.18",
    "tanstack-router-ga4": "^1.6.0",
    "tw-animate-css": "1.3.6",
    "zod": "4.4.3",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@rsbuild/core": "2.0.1",
    "@tailwindcss/typography": "0.5.16",
    "@tanstack/devtools-vite": "0.6.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.10.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitejs/plugin-rsc": "0.5.24",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "9.1.7",
    "jsdom": "28.1.0",
    "lint-staged": "16.4.0",
    "react-scan": "0.5.7",
    "typescript": "5.7.2",
    "vite": "8.0.0",
    "vitest": "3.0.5",
    "wrangler": "4.70.0"
  },
  "packageManager": "pnpm@11.2.2",
   "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
